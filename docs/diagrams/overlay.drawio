        <mxCell id="shape-5" value="" style="rounded=0;html=1;fillColor=#ef4444;strokeColor=none;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="446" width="250" height="4" as="geometry"/></mxCell>
        <mxCell id="shape-6" value="&lt;font color='#ffffff'&gt;And I want you to pause for a second and notice how strange it is&lt;br&gt;that staying balanced feels so &lt;/font&gt;&lt;font color='#8fd6ff'&gt;&lt;b&gt;&lt;u&gt;effortless&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;font color='#ffffff'&gt;.&lt;/font&gt;&lt;br&gt;&lt;font color='#ffe2a0' style='font-size:14px'&gt;我希望你能暂停一下，注意一下保持平衡竟然如此轻松这一事实有多奇怪。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0b0b0b;strokeColor=none;opacity=85;fontSize=15;spacing=10;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="640" height="100" as="geometry"/></mxCell>
        <mxCell id="shape-7" value="&lt;font color='#8fd6ff'&gt;&lt;b&gt;effortless&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#e5e7eb'&gt;在本句中：毫不费力&lt;/font&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;position=0.4;position2=0.5;base=16;size=14;rounded=1;arcSize=12;fillColor=#18181b;strokeColor=#52525b;align=left;spacingLeft=10;spacingTop=2;fontSize=13;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="236" width="210" height="84" as="geometry"/></mxCell>
        <mxCell id="shape-8" value="&lt;b&gt;英文&lt;/b&gt;跟着语音逐段显示&lt;br&gt;&lt;font color='#666666'&gt;自动字幕会高亮正在说的词&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="shape-9" value="&lt;b&gt;中文&lt;/b&gt;是整句的翻译&lt;br&gt;&lt;font color='#666666'&gt;按 Z 遮住，先自己理解&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="380" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="shape-10" value="&lt;b&gt;点单词 / 划选短语&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;本地模型给出它在本句的意思&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="236" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="shape-11" value="&lt;b&gt;鼠标移到字幕上&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;自动暂停，移开继续&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="350" width="200" height="50" as="geometry"/></mxCell>
